---
import { ClientRouter } from "astro:transitions";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    canonical?: string;
    image?: string;
    ogType?: "website" | "article";
    publishedTime?: Date | string;
}

const {
    title,
    description = "Ana F. Poletto - Psicóloga. Psicoterapia psicoanalítica online para personas que atraviesan sufrimiento subjetivo, angustia, crisis vitales y conflictos en los vínculos.",
    canonical,
    image,
    ogType = "website",
    publishedTime,
} = Astro.props;

const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = canonical
    ? new URL(canonical, siteOrigin).toString()
    : new URL(Astro.url.pathname, siteOrigin).toString();
const imageUrl = image ? new URL(image, siteOrigin).toString() : undefined;
const publishedTimeValue = publishedTime
    ? new Date(publishedTime).toISOString()
    : undefined;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.png" />
        <link rel="canonical" href={canonicalUrl} />
        <meta name="generator" content={Astro.generator} />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalUrl} />
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        {
            publishedTimeValue && (
                <meta
                    property="article:published_time"
                    content={publishedTimeValue}
                />
            )
        }
        {ogType === "article" && <meta property="article:author" content="Ana F. Poletto" />}

        <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {imageUrl && <meta name="twitter:image" content={imageUrl} />}

        <title>{title}</title>

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
            rel="stylesheet"
        />

        <ClientRouter />
    </head>
    <body class="min-h-screen flex flex-col bg-[#fcfcfc]">
        <NavBar />
        <main class="grow">
            <slot />
        </main>
        <Footer />

        <script>
            import gsap from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            gsap.registerPlugin(ScrollTrigger);
        </script>
    </body>
</html>
