---
import IconGraduationCap from "./icons/IconGraduationCap.astro";

interface Props {
    title: string;
    university: string;
    logoUrl?: string;
    logoAlt?: string;
}

const {
    title,
    university,
    logoUrl,
    logoAlt = "Logo universidad",
} = Astro.props;
---

<div
    class="credentials-card flex items-start gap-4 px-5 py-6 rounded-xl border border-slate-950/30"
>
    {
        logoUrl && (
            <div class="shrink-0 w-16 h-16 bg-slate-700 rounded-lg flex items-center justify-center">
                <img
                    src={logoUrl}
                    alt={logoAlt}
                    class="w-full h-full object-cover"
                />
            </div>
        )
    }
    {
        !logoUrl && (
            <div class="shrink-0 w-16 h-16 bg-slate-700 rounded-lg flex items-center justify-center">
                <IconGraduationCap class="w-8 h-8 text-slate-500" />
            </div>
        )
    }
    <div class="flex-1 min-w-0 text-slate-950">
        <h3 class="text-md mb-1 font-medium">
            {title}
        </h3>
        <p class="text-sm">
            {university}
        </p>
    </div>
</div>
