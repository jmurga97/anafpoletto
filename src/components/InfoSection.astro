---
const hasDefaultSlot = Astro.slots.default;
---

<section class="py-16 md:py-24 bg-global">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
            {
                hasDefaultSlot ? (
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <slot />
                    </div>
                ) : null
            }
        </div>
    </div>
</section>
