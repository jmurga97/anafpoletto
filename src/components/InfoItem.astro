---
const { title, description } = Astro.props as {
    title: string;
    description: string;
};
---

<div class="text-center">
    <div
        class="w-12 h-12 mx-auto mb-4 rounded-full bg-slate-800 flex items-center justify-center"
    >
        <slot name="icon" />
    </div>
    <h3 class="text-lg text-slate-950 mb-2 font-medium">{title}</h3>
    <p class="text-slate-800 text-sm">{description}</p>
</div>
